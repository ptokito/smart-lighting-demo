# =============================================================================
# Secrets in AWS Systems Manager Parameter Store (SecureString, encrypted with
# the AWS-managed key). The instances read these at boot; nothing secret is
# stored in the repo or in EC2 user data.
#
# Note: Terraform state does contain these values. State is git-ignored and
# lives only on your workstation for this demo; a customer would use an
# encrypted remote backend (an S3 bucket with encryption and locking).
# =============================================================================

locals {
  param_prefix = "/${var.name_prefix}/demo"
}

# Passwords generated by Terraform. special = false keeps them free of
# characters that need escaping in connection strings and shell scripts.
resource "random_password" "db" {
  length  = 32
  special = false
}

resource "random_password" "redis" {
  length  = 32
  special = false
}

resource "random_password" "newrelic_db" {
  length  = 32
  special = false
}

resource "aws_ssm_parameter" "newrelic_license_key" {
  name        = "${local.param_prefix}/newrelic-license-key"
  description = "New Relic ingest license key used by every agent"
  type        = "SecureString"
  value       = var.newrelic_license_key
}

resource "aws_ssm_parameter" "db_password" {
  name        = "${local.param_prefix}/db-password"
  description = "PostgreSQL password for the lighting app user"
  type        = "SecureString"
  value       = random_password.db.result
}

resource "aws_ssm_parameter" "redis_password" {
  name        = "${local.param_prefix}/redis-password"
  description = "Redis password"
  type        = "SecureString"
  value       = random_password.redis.result
}

resource "aws_ssm_parameter" "newrelic_db_password" {
  name        = "${local.param_prefix}/newrelic-db-password"
  description = "PostgreSQL password for the read-only New Relic monitoring user"
  type        = "SecureString"
  value       = random_password.newrelic_db.result
}
