{
  "_comment": "CloudWatch agent config for the host VM. Ships application, NGINX and PostgreSQL logs to one CloudWatch log group (3-day retention, set by Terraform). An hourly Lambda exports each hour of logs to the S3 archive bucket once it is 24 hours old. ${LOG_GROUP} is filled in by host-bootstrap.sh.",
  "agent": {
    "run_as_user": "root"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/smart-lighting/*.log",
            "log_group_name": "${LOG_GROUP}",
            "log_stream_name": "host/{instance_id}/apps",
            "timezone": "UTC"
          },
          {
            "file_path": "/var/log/nginx/access.log",
            "log_group_name": "${LOG_GROUP}",
            "log_stream_name": "host/{instance_id}/nginx-access",
            "timezone": "UTC"
          },
          {
            "file_path": "/var/log/nginx/error.log",
            "log_group_name": "${LOG_GROUP}",
            "log_stream_name": "host/{instance_id}/nginx-error",
            "timezone": "UTC"
          },
          {
            "file_path": "/var/log/postgresql/postgresql-16-main.log",
            "log_group_name": "${LOG_GROUP}",
            "log_stream_name": "host/{instance_id}/postgresql",
            "timezone": "UTC"
          }
        ]
      }
    }
  }
}
